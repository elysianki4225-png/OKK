# ================== OKK AI 炒币机器人 配置示例 ==================
# 复制为 .env 后修改。也可以直接在 Web 管理界面里配置（推荐）。

# 监听地址与端口（Caddy 反代到 127.0.0.1:8000）
HOST=127.0.0.1
PORT=8000

# Web 管理员密码（首次启动会自动生成并打印在日志里，务必修改）
# ADMIN_PASSWORD=请改成强密码

# 会话签名密钥（首次启动自动生成到 data/secret.key）
# SECRET_KEY=

# 数据目录（SQLite 数据库、密钥文件）
DATA_DIR=data

# 运行模式：live=实盘  paper=模拟盘（强烈建议先跑模拟盘）
TRADING_MODE=paper

# 默认时区（影响"今日盈亏"统计口径）
TZ_NAME=Asia/Shanghai

# 扫描间隔（秒）。越大越省 Token，默认 300 秒一轮
SCAN_INTERVAL=300

# 每轮扫描多少个成交量最大的合约币种（省 Token 关键参数）
SCAN_TOP_N=25

# 单次发给 AI 的 K 线数量
KLINE_LIMIT=120

# 日志级别
LOG_LEVEL=INFO
